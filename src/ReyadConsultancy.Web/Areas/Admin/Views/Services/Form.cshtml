@model Service
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "Services";
    ViewData["Menu"] = "Services";
}

<div class="card card-primary card-outline">
    <div class="card-header"><h3 class="card-title">@ViewData["Title"]</h3></div>
    <form method="post" enctype="multipart/form-data" asp-antiforgery="true">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Title">Title</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Slug">URL slug</label>
        <input asp-for="Slug" class="form-control" />
        <small class="form-text text-muted">Leave empty to generate from the title.</small>
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Subtitle">Category label</label>
        <input asp-for="Subtitle" class="form-control" />
        <span asp-validation-for="Subtitle" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ShortDescription">Short description</label>
        <textarea asp-for="ShortDescription" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ShortDescription" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description">Full description</label>
        <textarea asp-for="Description" class="form-control summernote" rows="8"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Card / tab image</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mb-2"><img src="@Model.ImageUrl" alt="" class="img-thumbnail" style="max-height:110px;background:#ddd" /></div>
        }
        <input type="hidden" asp-for="ImageUrl" />
        <div class="custom-file">
            <input type="file" class="custom-file-input" id="ImageUrlFile" name="ImageUrlFile" accept="image/png,image/jpeg,image/gif,image/webp" />
            <label class="custom-file-label" for="ImageUrlFile">Choose image (max 5 MB)</label>
        </div>
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Icon image</label>
        @if (!string.IsNullOrEmpty(Model.IconUrl))
        {
            <div class="mb-2"><img src="@Model.IconUrl" alt="" class="img-thumbnail" style="max-height:110px;background:#ddd" /></div>
        }
        <input type="hidden" asp-for="IconUrl" />
        <div class="custom-file">
            <input type="file" class="custom-file-input" id="IconUrlFile" name="IconUrlFile" accept="image/png,image/jpeg,image/gif,image/webp" />
            <label class="custom-file-label" for="IconUrlFile">Choose image (max 5 MB)</label>
        </div>
        <span asp-validation-for="IconUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Detail page image</label>
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <div class="mb-2"><img src="@Model.BannerImageUrl" alt="" class="img-thumbnail" style="max-height:110px;background:#ddd" /></div>
        }
        <input type="hidden" asp-for="BannerImageUrl" />
        <div class="custom-file">
            <input type="file" class="custom-file-input" id="BannerImageUrlFile" name="BannerImageUrlFile" accept="image/png,image/jpeg,image/gif,image/webp" />
            <label class="custom-file-label" for="BannerImageUrlFile">Choose image (max 5 MB)</label>
        </div>
        <span asp-validation-for="BannerImageUrl" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SortOrder">Sort order</label>
        <input asp-for="SortOrder" type="number" class="form-control" />
        <span asp-validation-for="SortOrder" class="text-danger"></span>
    </div>
    <div class="form-group">
        <div class="custom-control custom-switch">
            <input asp-for="IsActive" type="checkbox" class="custom-control-input" />
            <label class="custom-control-label" asp-for="IsActive">Active</label>
        </div>
    </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
            <a asp-action="Index" class="btn btn-default">Cancel</a>
        </div>
    </form>
</div>
