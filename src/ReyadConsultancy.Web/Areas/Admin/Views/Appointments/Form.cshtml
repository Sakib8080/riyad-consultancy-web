@model Appointment
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + "Appointments";
    ViewData["Menu"] = "Appointments";
}

<div class="card card-primary card-outline">
    <div class="card-header"><h3 class="card-title">@ViewData["Title"]</h3></div>
    <form method="post" enctype="multipart/form-data" asp-antiforgery="true">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="FirstName">First Name</label>
        <input asp-for="FirstName" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="LastName">Last Name</label>
        <input asp-for="LastName" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="Phone">Phone</label>
        <input asp-for="Phone" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="AppointmentDate">Preferred date</label>
        <input asp-for="AppointmentDate" type="date" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="AppointmentTime">Preferred time</label>
        <input asp-for="AppointmentTime" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="CustomerId">Customer Id</label>
        <input asp-for="CustomerId" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="CaseType">Case Type</label>
        <input asp-for="CaseType" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="Gender">Gender</label>
        <input asp-for="Gender" class="form-control" readonly="readonly" />
    </div>
    <div class="form-group">
        <label asp-for="Message">Details</label>
        <textarea asp-for="Message" class="form-control" rows="5" readonly="readonly"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="Status">Status</label>
        <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<AppointmentStatus>()"></select>
    </div>
    <div class="form-group">
        <label asp-for="AdminNotes">Internal notes</label>
        <textarea asp-for="AdminNotes" class="form-control" rows="4"></textarea>
        <span asp-validation-for="AdminNotes" class="text-danger"></span>
    </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Save</button>
            <a asp-action="Index" class="btn btn-default">Cancel</a>
        </div>
    </form>
</div>
