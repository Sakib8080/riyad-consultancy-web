@model LoginViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Sign in";
}
<div class="login-box">
    <div class="login-logo"><a href="/"><b>RBSC</b> Admin</a></div>
    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Sign in to manage the website</p>

            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success">@ok</div>
            }
            <div asp-validation-summary="All" class="text-danger small mb-2"></div>

            <form method="post" asp-antiforgery="true" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                <div class="input-group mb-3">
                    <input asp-for="Email" type="email" class="form-control" placeholder="Email" autocomplete="username">
                    <div class="input-group-append"><div class="input-group-text"><span class="fas fa-envelope"></span></div></div>
                </div>
                <div class="input-group mb-3">
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" autocomplete="current-password">
                    <div class="input-group-append"><div class="input-group-text"><span class="fas fa-lock"></span></div></div>
                </div>
                <div class="row">
                    <div class="col-8">
                        <div class="icheck-primary">
                            <input asp-for="RememberMe" type="checkbox">
                            <label asp-for="RememberMe">Remember me</label>
                        </div>
                    </div>
                    <div class="col-4"><button type="submit" class="btn btn-primary btn-block">Sign In</button></div>
                </div>
            </form>

            <p class="mb-1 mt-3"><a asp-action="Register" class="text-center">Register a new account</a></p>
            <p class="mb-0"><a href="/">Back to website</a></p>
        </div>
    </div>
</div>
