@using System.Security.Claims
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] names) => names.Contains(ctrl, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    string Open(params string[] names) => names.Contains(ctrl, StringComparer.OrdinalIgnoreCase) ? "menu-open" : "";
    var userName = User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - RBSC Admin</title>
    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="/admin/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/admin/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="/admin/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="/admin/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
    <link rel="stylesheet" href="/admin/plugins/summernote/summernote-bs4.min.css">
    <link rel="stylesheet" href="/admin/dist/css/adminlte.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a></li>
            <li class="nav-item d-none d-sm-inline-block"><a href="/" target="_blank" class="nav-link"><i class="fas fa-external-link-alt mr-1"></i> View website</a></li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item"><span class="nav-link text-muted"><i class="far fa-user mr-1"></i>@userName</span></li>
            <li class="nav-item">
                <form method="post" asp-area="Admin" asp-controller="Account" asp-action="Logout" class="form-inline">
                    <button type="submit" class="btn btn-link nav-link"><i class="fas fa-sign-out-alt"></i> Logout</button>
                </form>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-link">
            <img src="/admin/dist/img/AdminLTELogo.png" alt="RBSC" class="brand-image img-circle elevation-3" style="opacity:.8">
            <span class="brand-text font-weight-light">RBSC Admin</span>
        </a>
        <div class="sidebar">
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                    <li class="nav-item"><a asp-controller="Dashboard" asp-action="Index" class="nav-link @Active("Dashboard")"><i class="nav-icon fas fa-tachometer-alt"></i><p>Dashboard</p></a></li>

                    <li class="nav-header">WEBSITE CONTENT</li>
                    <li class="nav-item"><a asp-controller="Settings" asp-action="Index" class="nav-link @Active("Settings")"><i class="nav-icon fas fa-cog"></i><p>Site Settings</p></a></li>
                    <li class="nav-item"><a asp-controller="Slides" asp-action="Index" class="nav-link @Active("Slides")"><i class="nav-icon fas fa-images"></i><p>Home Slider</p></a></li>
                    <li class="nav-item"><a asp-controller="Features" asp-action="Index" class="nav-link @Active("Features")"><i class="nav-icon fas fa-star"></i><p>Feature Boxes</p></a></li>
                    <li class="nav-item"><a asp-controller="AboutItems" asp-action="Index" class="nav-link @Active("AboutItems")"><i class="nav-icon fas fa-info-circle"></i><p>About Items</p></a></li>
                    <li class="nav-item"><a asp-controller="AboutHighlights" asp-action="Index" class="nav-link @Active("AboutHighlights")"><i class="nav-icon fas fa-lightbulb"></i><p>About Highlights</p></a></li>
                    <li class="nav-item"><a asp-controller="PageContents" asp-action="Index" class="nav-link @Active("PageContents")"><i class="nav-icon fas fa-file-alt"></i><p>Page Text Blocks</p></a></li>
                    <li class="nav-item"><a asp-controller="Services" asp-action="Index" class="nav-link @Active("Services")"><i class="nav-icon fas fa-briefcase"></i><p>Services</p></a></li>
                    <li class="nav-item"><a asp-controller="Faqs" asp-action="Index" class="nav-link @Active("Faqs")"><i class="nav-icon fas fa-question-circle"></i><p>FAQs</p></a></li>
                    <li class="nav-item"><a asp-controller="Counters" asp-action="Index" class="nav-link @Active("Counters")"><i class="nav-icon fas fa-tachometer-alt"></i><p>Counters</p></a></li>
                    <li class="nav-item"><a asp-controller="TeamMembers" asp-action="Index" class="nav-link @Active("TeamMembers")"><i class="nav-icon fas fa-users"></i><p>Team Members</p></a></li>
                    <li class="nav-item"><a asp-controller="Testimonials" asp-action="Index" class="nav-link @Active("Testimonials")"><i class="nav-icon fas fa-quote-right"></i><p>Testimonials</p></a></li>
                    <li class="nav-item"><a asp-controller="ClientLogos" asp-action="Index" class="nav-link @Active("ClientLogos")"><i class="nav-icon fas fa-handshake"></i><p>Client Logos</p></a></li>

                    <li class="nav-header">BLOG</li>
                    <li class="nav-item"><a asp-controller="BlogPosts" asp-action="Index" class="nav-link @Active("BlogPosts")"><i class="nav-icon fas fa-newspaper"></i><p>Posts</p></a></li>
                    <li class="nav-item"><a asp-controller="BlogCategories" asp-action="Index" class="nav-link @Active("BlogCategories")"><i class="nav-icon fas fa-folder"></i><p>Categories</p></a></li>
                    <li class="nav-item"><a asp-controller="BlogComments" asp-action="Index" class="nav-link @Active("BlogComments")"><i class="nav-icon fas fa-comments"></i><p>Comments</p></a></li>

                    <li class="nav-header">INQUIRIES</li>
                    <li class="nav-item"><a asp-controller="ContactMessages" asp-action="Index" class="nav-link @Active("ContactMessages")"><i class="nav-icon fas fa-envelope"></i><p>Contact Messages</p></a></li>
                    <li class="nav-item"><a asp-controller="Appointments" asp-action="Index" class="nav-link @Active("Appointments")"><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a></li>
                    <li class="nav-item"><a asp-controller="Subscribers" asp-action="Index" class="nav-link @Active("Subscribers")"><i class="nav-icon fas fa-at"></i><p>Subscribers</p></a></li>

                    <li class="nav-header">SYSTEM</li>
                    <li class="nav-item"><a asp-controller="Users" asp-action="Index" class="nav-link @Active("Users")"><i class="nav-icon fas fa-user-shield"></i><p>Users</p></a></li>
                    <li class="nav-item"><a asp-controller="Profile" asp-action="ChangePassword" class="nav-link @Active("Profile")"><i class="nav-icon fas fa-key"></i><p>Change Password</p></a></li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid"><h1 class="m-0">@ViewData["Title"]</h1></div>
        </div>
        <section class="content">
            <div class="container-fluid">
                @if (TempData["Success"] is string ok)
                {
                    <div class="alert alert-success alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button><i class="fas fa-check mr-1"></i> @ok</div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="alert alert-danger alert-dismissible"><button type="button" class="close" data-dismiss="alert">&times;</button><i class="fas fa-exclamation-triangle mr-1"></i> @err</div>
                }
                @RenderBody()
            </div>
        </section>
    </div>

    <footer class="main-footer"><strong>Reyad Business Solution and Consultancy</strong> - Admin panel</footer>
</div>

<script src="/admin/plugins/jquery/jquery.min.js"></script>
<script src="/admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/admin/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
<script src="/admin/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="/admin/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/admin/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
<script src="/admin/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
<script src="/admin/plugins/summernote/summernote-bs4.min.js"></script>
<script src="/admin/dist/js/adminlte.min.js"></script>
<script>
    $(function () {
        $('.summernote').summernote({
            height: 260,
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['insert', ['link', 'table']],
                ['view', ['codeview']]
            ]
        });
        $('.custom-file-input').on('change', function () {
            var name = this.files && this.files.length ? this.files[0].name : 'Choose image';
            $(this).next('.custom-file-label').text(name);
        });
        $('.confirm-delete').on('submit', function () { return confirm('Delete this item? This cannot be undone.'); });
        if ($('#crudTable').length) {
            $('#crudTable').DataTable({ responsive: true, order: [], pageLength: 25, columnDefs: [{ orderable: false, targets: -1 }] });
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
