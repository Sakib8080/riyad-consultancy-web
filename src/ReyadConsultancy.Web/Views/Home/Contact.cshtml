@model ContactForm
@inject IWebsiteContentService Site
@{
    ViewData["Title"] = "Contact";
    ViewData["Banner"] = "Contact";
    ViewData["ShowMap"] = true;
    var s = (await Site.GetLayoutAsync()).Settings;
    var hasMap = s.MapLatitude.HasValue && s.MapLongitude.HasValue && !string.IsNullOrWhiteSpace(s.GoogleMapsApiKey);
    var lat = (s.MapLatitude ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
    var lng = (s.MapLongitude ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<div class="container">
    @if (hasMap)
    {
        <div class="container-fluid map-block">
            <div class="map-canvas" id="contact-map-canvas" data-lat="@lat" data-lng="@lng" data-string="@s.Address" data-zoom="10"></div>
        </div>
        <div class="clearfix"></div>
    }
    <div class="col-md-4 col-xs-12 contact-content">
        <div class="contact-details">
            <h3>Contact Us?</h3>
            @if (!string.IsNullOrWhiteSpace(s.Address))
            {
                <div class="contact-detail-box"><h4>ADDRESS:</h4><p>@s.Address</p></div>
            }
            <div class="contact-detail-box">
                <h4>EMAIL ID:</h4>
                @if (!string.IsNullOrWhiteSpace(s.Email1)) { <p><a href="mailto:@s.Email1">@s.Email1</a></p> }
                @if (!string.IsNullOrWhiteSpace(s.Email2)) { <p><a href="mailto:@s.Email2">@s.Email2</a></p> }
            </div>
            <div class="contact-detail-box">
                <h4>PHONE:</h4>
                @if (!string.IsNullOrWhiteSpace(s.Phone1)) { <p><a href="tel:@s.Phone1">@s.Phone1</a></p> }
                @if (!string.IsNullOrWhiteSpace(s.Phone2)) { <p><a href="tel:@s.Phone2">@s.Phone2</a></p> }
            </div>
        </div>
    </div>
    <div class="col-md-8 col-xs-12 contact-form">
        <h3>Send Us a Message</h3>
        <form method="post" asp-antiforgery="true">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <input asp-for="Name" class="form-control" placeholder="Enter Your Name*" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Phone" class="form-control" placeholder="Phone Number*" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Email" type="email" class="form-control" placeholder="Email Address" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input asp-for="Address" class="form-control" placeholder="Enter Your Address" />
            </div>
            <div class="form-group">
                <textarea asp-for="Message" class="form-control" placeholder="Message*"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div style="position:absolute;left:-5000px" aria-hidden="true"><input asp-for="Website" tabindex="-1" autocomplete="off" /></div>
            <button title="SEND MESSAGE" type="submit">SEND MESSAGE</button>
        </form>
    </div>
</div>
