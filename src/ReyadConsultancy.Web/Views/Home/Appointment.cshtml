@model AppointmentForm
@{
    ViewData["Title"] = "Appointment";
    ViewData["Banner"] = "appointment";
    var why = ViewBag.WhyChoose as PageContent;
}
@inject IWebsiteContentService Site
@{
    var s = (await Site.GetLayoutAsync()).Settings;
}

<div class="container-fluid no-left-padding no-right-padding appointment-section">
    <div class="container">
        <div class="row">
            <div class="col-md-9 content-area">
                <div class="appointment-form">
                    <h3>Please complete the details below to submit your booking request</h3>
                    <form class="row" method="post" asp-antiforgery="true">
                        <div asp-validation-summary="All" class="text-danger col-md-12"></div>
                        <div class="col-md-6 form-group"><label>First Name*</label><input asp-for="FirstName" class="form-control" /></div>
                        <div class="col-md-6 form-group"><label>Last Name</label><input asp-for="LastName" class="form-control" /></div>
                        <div class="col-md-6 form-group"><label>Phone*</label><input asp-for="Phone" class="form-control" /></div>
                        <div class="col-md-6 form-group"><label>Email</label><input asp-for="Email" type="email" class="form-control" /></div>
                        <div class="col-md-6 form-group"><label>Date</label><input asp-for="AppointmentDate" type="date" class="form-control" /></div>
                        <div class="col-md-6 form-group"><label>Time</label><input asp-for="AppointmentTime" type="time" class="form-control" /></div>
                        <div class="col-md-6 form-group"><label>Customer Id</label><input asp-for="CustomerId" class="form-control" /></div>
                        <div class="col-md-6 form-group"><label>Service / Case Type</label><input asp-for="CaseType" class="form-control" /></div>
                        <div class="col-md-12 form-group"><label>Message</label><textarea asp-for="Message" class="form-control"></textarea></div>
                        <div style="position:absolute;left:-5000px" aria-hidden="true"><input asp-for="Website" tabindex="-1" autocomplete="off" /></div>
                        <div class="col-md-12"><input type="submit" value="Book Now"></div>
                    </form>
                </div>
            </div>
            <div class="col-md-3 sidebr">
                @if (why != null)
                {
                    <div class="why-choose-box">
                        <h3>@why.Title</h3>
                        @Html.Raw(why.Body)
                    </div>
                }
                <div class="contact-details">
                    <h3>Contact Us?</h3>
                    @if (!string.IsNullOrWhiteSpace(s.Address)) { <div class="contact-detail-box"><h4>ADDRESS:</h4><p>@s.Address</p></div> }
                    <div class="contact-detail-box">
                        <h4>EMAIL ID:</h4>
                        @if (!string.IsNullOrWhiteSpace(s.Email1)) { <p><a href="mailto:@s.Email1">@s.Email1</a></p> }
                    </div>
                    <div class="contact-detail-box">
                        <h4>PHONE:</h4>
                        @if (!string.IsNullOrWhiteSpace(s.Phone1)) { <p><a href="tel:@s.Phone1">@s.Phone1</a></p> }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
